#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"
export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"
# Forward host UID/GID into the container so the worker exit-trap
# can chown each per-task workspace back to the launching user.
# Phase 4 §6 retired the entrypoint.sh trap; the chown now lives
# inline in orchestrator/worker.py's bash command. The post-prune
# eval harness does not invoke a producer, so this is a no-op for
# eval but kept for symmetry with uas-orchestrate.
export UAS_HOST_UID="${UAS_HOST_UID:-$(id -u)}"
export UAS_HOST_GID="${UAS_HOST_GID:-$(id -g)}"
exec python3 -P -m integration.eval "$@"
